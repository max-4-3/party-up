<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title and Percentage Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/uploadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="finest_flower_in_gardeeen.mov"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/uploadPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00%"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/uploadStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:maxWidth="300dp"
        android:maxLines="1"
        android:text="Idle..."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <!-- Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/uploadProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:max="100" />

    <!-- Details Stats List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Elapsed Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="elapsed time:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/uploadTimeElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.4 min"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bytes Sent (Done) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="bytes send:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/uploadBytesDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="438300943029292"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bytes Left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="bytes left:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/uploadBytesLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="240942000932000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bytes Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="bytes total:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/uploadBytesTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="679243943961292"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Started At -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="started at:"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/uploadTimeStarted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27 nov, 2020"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/uploadActionPause"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Pause" />

        <Button
            android:id="@+id/uploadActionStop"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Stop" />

        <Button
            android:id="@+id/uploadActionInfo"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Info" />

        <Button
            android:id="@+id/uploadActionRemove"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove" />
    </LinearLayout>

</LinearLayout>
