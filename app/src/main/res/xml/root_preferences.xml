<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Connection">

        <EditTextPreference
            android:autofillHints="url"
            android:defaultValue="@string/server_default_url"
            android:inputType="textUri"
            android:key="server_url"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="Server URL"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="server_password"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="Password"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
    <PreferenceCategory android:title="Behavior">
        <SwitchPreference
            android:defaultValue="false"
            android:key="auto_send"
            android:title="Just go"
            app:summary="Skip confirmation screen" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Share links">
        <EditTextPreference
            android:defaultValue=""
            android:key="link_expiration"
            android:title="Default expiration (e.g., 10m, 2h, 1d)" />
        <EditTextPreference
            android:defaultValue=""
            android:key="share_password"
            android:title="Default password"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
